# ── Binance Web3 API (server-side only; NEVER prefix with NEXT_PUBLIC_) ──
# Create at https://web3.binance.com/en/dev-portal/project
# Leave empty to run in DEMO MODE (mocked data, no real trades).
BINANCE_W3W_API_KEY=
BINANCE_W3W_API_SECRET=

# ── WalletConnect / Reown (public, safe in the browser) ──
# Free project ID from https://dashboard.reown.com  — enables QR codes on desktop
# and deep links to MetaMask / Binance Wallet / Trust Wallet on phones.
# Without it, only browser-extension wallets and wallet in-app browsers work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: your public site URL (used as WalletConnect metadata during server rendering)
NEXT_PUBLIC_SITE_URL=

# Optional: force demo mode even when keys are present (1 = on)
FIRST_SHARE_FORCE_DEMO=
